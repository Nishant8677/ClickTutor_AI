# Copy this file to .env and fill in the value. .env is gitignored.
#
# Google Gemini API key, used for lesson generation and screenshot
# classification. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. A second key, used only by benchmarks that need a model tier the
# main account cannot reach:
#   python tools/locator_experiment.py --relocate <model> --api-key-env GEMINI_API_KEY_PRO
GEMINI_API_KEY_PRO=
