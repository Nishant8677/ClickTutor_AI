# Virtual environments. venv/ is the WSL one used for tests and tooling;
# venv-win/ is the native Windows one the desktop overlay must be run from.
venv/
venv-win/

# Environment variables
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# Runtime-generated artifacts (captures, highlights, recordings, logs)
runtime/
.temp/

# Generated images in project root (legacy paths, still ignored for safety).
# Leading slash anchors these to the repo root — an unanchored pattern matches
# at any depth and would silently exclude committed assets such as
# demo/<name>/screenshot.png.
/temp_image.png
/selected_region.png
/screenshot.png
/highlighted_image.png
*_highlighted.png
debug_*.png
*_capture.png
/current_capture.png

# Test images (not committed — stored in assets/test_images/ or demo/)
/sample.png
/sample2.png

# Video recordings. The published demo is a tracked release asset.
*.mp4
!assets/demo/*.mp4

# Benchmark outputs
benchmark_chart.png
benchmark_results.json

# Logs
*.log

# Sessions
.clicktutor_sessions/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Windows NTFS alternate-data-stream markers. The ':' is illegal in a Windows
# filename, so committing one makes the repo impossible to check out there.
*Zone.Identifier

# Archive (optional: remove if you want archive to be tracked)
# archive/

# Old experiment clones (review before committing)
clicky_repo/
