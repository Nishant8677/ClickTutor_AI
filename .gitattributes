# This repository is worked on from both WSL and Windows, whose git installs
# disagree: the Windows one has core.autocrlf=input, the WSL one has it unset.
# That mismatch produced phantom whole-file diffs. Normalising here settles it
# for every clone regardless of local config.
* text=auto eol=lf

# PowerShell is invoked by Windows and is happiest with CRLF on disk.
*.ps1 text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.ico binary
*.pdf binary
